rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'ashivamone@gmail.com';
    }

    // Connection testing endpoint
    match /test/{testDoc} {
      allow read, write: if true;
    }

    // User accounts
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // User activity logs & telemetry for admin user tracking
    match /user_activity/{activityId} {
      allow create: if true;
      allow read, delete: if isAdmin();
    }

    // Master Timetable branch & semester overrides
    match /timetable_overrides/{branchSemesterKey} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Course syllabus & faculty overrides
    match /course_overrides/{courseCode} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Institute Academic Announcements
    match /institute_announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
